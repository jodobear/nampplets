{
  "schema": 1,
  "clock": {
    "kind": "manual",
    "initial_unix_seconds": 1700000000
  },
  "limits": {
    "max_frame_bytes": 1048576,
    "max_connections": 32,
    "max_requests_per_connection": 256,
    "max_blob_bytes": 4194304
  },
  "relay": [
    {
      "id": "eose-empty",
      "script": ["accept", "eose"],
      "observable": "connected-eose-no-match"
    },
    {
      "id": "event-then-eose",
      "script": ["accept", "event:public-note", "eose"],
      "observable": "event-and-scoped-eose"
    },
    {
      "id": "auth-required",
      "script": ["accept", "auth:challenge-1", "await-auth", "event:public-note", "eose"],
      "observable": "auth-challenge-and-success"
    },
    {
      "id": "auth-denied",
      "script": ["accept", "auth:challenge-1", "closed:auth-denied"],
      "observable": "auth-denied"
    },
    {
      "id": "relay-error",
      "script": ["accept", "closed:programmed-error"],
      "observable": "typed-relay-error"
    },
    {
      "id": "disconnect-reconnect",
      "script": ["accept", "disconnect", "accept", "event:public-note", "eose"],
      "observable": "two-connection-generations"
    },
    {
      "id": "replacement",
      "script": ["accept", "event:replaceable-old", "event:replaceable-new", "eose"],
      "observable": "canonical-replacement-input"
    },
    {
      "id": "deletion",
      "script": ["accept", "event:public-note", "event:delete-public-note", "eose"],
      "observable": "canonical-deletion-input"
    },
    {
      "id": "expiry",
      "script": ["accept", "event:expiring-note", "clock:+61", "eose"],
      "observable": "expiry-input-after-clock-advance"
    }
  ],
  "blob": [
